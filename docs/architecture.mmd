%% =============================================================================
%% RUDRA — Technical Architecture Diagram (Mermaid source)
%% Render with:  mmdc -i architecture.mmd -o architecture.png -w 1800 -H 1100
%% or paste into https://mermaid.live  and export as PNG/SVG/PDF.
%% =============================================================================
flowchart TB
    classDef src   fill:#fef3c7,stroke:#d97706,color:#78350f,stroke-width:1.5px
    classDef ing   fill:#fde68a,stroke:#b45309,color:#78350f,stroke-width:1.5px
    classDef core  fill:#eef2ff,stroke:#4338ca,color:#1e1b4b,stroke-width:1.5px
    classDef det   fill:#fce7f3,stroke:#be185d,color:#831843,stroke-width:1.5px
    classDef ml    fill:#dbeafe,stroke:#1e40af,color:#1e3a8a,stroke-width:1.5px
    classDef store fill:#dcfce7,stroke:#16a34a,color:#14532d,stroke-width:1.5px
    classDef ai    fill:#ede9fe,stroke:#7c3aed,color:#4c1d95,stroke-width:1.5px
    classDef fe    fill:#e0f2fe,stroke:#0284c7,color:#0c4a6e,stroke-width:1.5px

    subgraph SRC["1. Data Sources and Ingestion"]
        K["Apache Kafka<br/>aiokafka + KRaft<br/>single broker"]:::src
        IBM["IBM AML 100k benchmark<br/>+ PaySim secondary"]:::src
        AA["Sahamati Account<br/>Aggregator (httpx)"]:::src
        KYC["DiliSense KYC<br/>screening (httpx)"]:::src
    end

    subgraph BE["2. FastAPI Backend  (51+ endpoints, RBAC via X-User-Role)"]
        ING["Live ingest<br/>live_scoring.score_live_txn<br/>sub-ms per transaction"]:::ing
        FFG["Fund-Flow Graph<br/>NetworkX DiGraph<br/>incremental + SCC cached"]:::core

        subgraph DET["Detection Engine (6 detectors run in parallel)"]
            D1["Cycle<br/>Johnson + SCC<br/>+ log-amount bucketing"]:::det
            D2["Layering<br/>BFS chain<br/>+ monotonic flow"]:::det
            D3["Smurfing<br/>threshold cluster<br/>+ burst window"]:::det
            D4["Shell Funnel<br/>imbalance ratio<br/>+ pass-through"]:::det
            D5["Dormant<br/>gap detect<br/>+ Z-score spike"]:::det
            D6["Profile Mismatch<br/>KYC-rule check"]:::det
        end

        subgraph MLS["Machine Learning Stack"]
            XGB["XGBoost edge classifier<br/>30 features, stratified 80/20"]:::ml
            SAGE["GraphSAGE GNN<br/>2-layer SAGEConv"]:::ml
            ENS["Stacked Ensemble<br/>3-fold out-of-fold<br/>+ LR meta-learner"]:::ml
            RWB["Risk Weights LR<br/>learned composite score"]:::ml
            SH["SHAP TreeExplainer<br/>per-alert attribution"]:::ml
        end

        CLUST["Incident Clustering<br/>union-find on entity overlap"]:::core
        CASE["Case Workbench<br/>state machine<br/>+ role gate"]:::core
        AUDIT["SHA-256 hash chain<br/>tamper-evident audit log"]:::core
        FIU["FIU Evidence Package<br/>STR XML + SAR PDF<br/>+ subgraph + chain"]:::core
    end

    subgraph ST["3. Storage"]
        DB[("SQLite<br/>cases + audit + config")]:::store
        FILES[("data/&lt;variant&gt;/<br/>transactions, alerts,<br/>ML artefacts")]:::store
    end

    subgraph GAI["4. GenAI Investigation Copilot"]
        CL["Anthropic Claude<br/>Haiku 4.5<br/>multi-round tool calling"]:::ai
        TLS["4 tools:<br/>trace_funds, find_cycles,<br/>explain_alert,<br/>get_profile_delta"]:::ai
    end

    subgraph FE["5. React 19 Frontend  (Vite + Tailwind 4)"]
        DASH[Dashboard / KPIs]:::fe
        CASES[Case Workbench]:::fe
        JNY[Journey:<br/>Flow Story + Timeline]:::fe
        NET[Network Graph:<br/>Matrix / Arc / Force]:::fe
        LIVE[Live Stream]:::fe
        SETT[Settings + Pipeline]:::fe
        COP[Copilot chat]:::fe
    end

    K   --> ING
    IBM --> FFG
    AA  --> FFG
    KYC --> FFG
    ING --> FFG
    FFG --> DET
    FFG --> MLS
    DET --> CLUST
    MLS --> CLUST
    CLUST --> CASE
    CASE  --> AUDIT
    CASE  --> FIU
    AUDIT --> DB
    CASE  --> DB
    FFG  -.persist.-> FILES
    MLS  -.persist.-> FILES

    BE  -- "REST + X-User-Role" --> FE
    COP -- "POST /api/copilot/query" --> CL
    CL  --> TLS
    TLS -- "executes against backend state" --> BE
